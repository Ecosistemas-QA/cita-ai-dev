# ============================================================================
# Cita.ai - Variables de entorno
# ============================================================================
#
# Copiá este archivo a .env y completá los valores:
#
#     cp .env.example .env
#
# El .env NUNCA se commitea (está en .gitignore). Este archivo declara QUÉ
# variables hacen falta; los valores se piden al responsable del entorno.
#
# Para cargarlas en la shell sin exponerlas:
#
#     set -a; . ./.env; set +a
#
# ============================================================================


# ----------------------------------------------------------------------------
# Supabase - Postgres, Auth y Row Level Security
# ----------------------------------------------------------------------------

# Obligatoria. Sin esta variable falla el build: src/lib/config.ts lanza una
# excepción a nivel de módulo, y ese módulo lo importan el middleware y los dos
# clientes de Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Obligatoria, mismo motivo. Es la clave pública: viaja al navegador y la
# protección real la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Obligatoria en ejecución. Saltea RLS, así que solo se usa del lado del
# servidor (src/lib/supabase/server.ts, createAdminClient).
# Sin ella, el portal público de reservas devuelve error: las rutas de
# /api/public/ y el control del plan gratuito dependen de este cliente.
# Nunca se expone al navegador ni se imprime por consola.
SUPABASE_SERVICE_ROLE_KEY=


# ----------------------------------------------------------------------------
# Resend - correos transaccionales
# ----------------------------------------------------------------------------

# Obligatoria en ejecución. El cliente se construye al importar el módulo
# (src/lib/email/client.ts), así que si falta, el error no aparece al mandar un
# correo sino al cargar cualquier ruta que importe el módulo de email.
RESEND_API_KEY=


# ----------------------------------------------------------------------------
# Aplicación
# ----------------------------------------------------------------------------

# Obligatoria en ejecución, y no tiene valor por defecto.
# Con esta URL se arma el enlace de cancelación que viaja en el correo de
# confirmación (src/lib/email/send.ts). Si falta, el enlace sale como
# "undefined/cancelar/<id>" y el cliente no puede cancelar su turno.
# En local:     http://localhost:3000
# En un deploy: la URL de ese deploy, sin barra final.
NEXT_PUBLIC_APP_URL=

# Opcional. Zona horaria con la que se calculan los horarios disponibles.
# Si no se define, se usa America/Argentina/Buenos_Aires.
NEXT_PUBLIC_APP_TIME_ZONE=


# ----------------------------------------------------------------------------
# Notas
# ----------------------------------------------------------------------------
# - Las variables NEXT_PUBLIC_* quedan embebidas en el bundle del navegador.
#   No poner un secreto detrás de ese prefijo.
# - Un cambio de dominio no alcanza con tocar NEXT_PUBLIC_APP_URL: el callback
#   de autenticación se arma con window.location.origin, así que el origen
#   nuevo también tiene que estar en las Redirect URLs de Supabase Auth.
# ----------------------------------------------------------------------------
